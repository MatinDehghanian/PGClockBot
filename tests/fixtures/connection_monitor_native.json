              "allowInsecure": false,
              "alpn": [
                "http/1.1"
              ]
            },
            "xhttpSettings": {
              "host": "cdn.example",
              "path": "/upload",
              "mode": "auto"
            }
          }
        },
        {
          "protocol": "freedom",
          "tag": "direct",
          "settings": {}
        }
      ]
    },
    {
      "remarks": "Synthetic Shadowsocks TCP",
      "outbounds": [
        {
          "protocol": "shadowsocks",
