# Leave secrets empty — the first-run wizard generates/collects them.
# Never commit a filled .env. Copying this file alone must NOT produce a login-ready panel.
BOT_TOKEN=""
BOT_USERNAME=""
ADMIN_IDS=""
PG_BASE_URL=""
PG_USERNAME=""
PG_PASSWORD=""
# Optional: skip login and use a ready token
# PG_ACCESS_TOKEN=""

WEB_HOST="0.0.0.0"
WEB_PORT="9000"
# Auto-generated on first start if empty/placeholder
WEB_SECRET=""
WEB_ADMIN_USER="admin"
# Set only via wizard or: python -m scripts.set_web_password
WEB_ADMIN_PASSWORD=""

# sqlite+aiosqlite:///./data/bot.db  OR  postgresql+asyncpg://user:pass@localhost/pgclock
DATABASE_URL="sqlite+aiosqlite:///./data/bot.db"

# Leave empty for polling. Set full https URL for webhook mode.
WEBHOOK_URL=""
WEBHOOK_PATH="/telegram/webhook"
# Optional: Telegram webhook secret. Auto-generated into data/webhook_secret.token if empty.
# WEBHOOK_SECRET_TOKEN=""

# Public https base for Mini App (e.g. https://bot.example.com). Empty = chat-only UX.
PUBLIC_BASE_URL=""

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-*.
TRUST_PROXY="0"

CURRENCY="Toman"
DEFAULT_LOCALE="fa"
